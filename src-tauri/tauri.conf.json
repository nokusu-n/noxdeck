{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noxdeck",
  "identifier": "app.noxdeck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Noxdeck", "create": false, "width": 960, "height": 720, "minWidth": 640, "minHeight": 480, "decorations": false }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "publisher": "Nokusu.dev",
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": { "nsis": {
      "installMode": "currentUser",
      "installerHooks": "./windows/hooks.nsh",
      "installerIcon": "icons/icon.ico",
      "uninstallerIcon": "icons/icon.ico"
    } }
  }
}
